---
import BaseLayout from '../layouts/BaseLayout.astro';
import PatternCard from '../components/PatternCard.astro';
import PatternFinder from '../components/PatternFinder.astro';
import { patterns, categoryLabels } from '../data/patterns';

const grouped = {
  creational: patterns.filter((p) => p.category === 'creational'),
  structural: patterns.filter((p) => p.category === 'structural'),
  behavioral: patterns.filter((p) => p.category === 'behavioral'),
};
---

<BaseLayout title="Patterns in Practice">
  <section class="mb-16 text-center sm:text-left">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-400">Design patterns · Java</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Learn when to use each pattern,<br class="hidden sm:block" />
      not just what they are.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-400">
      Real-life analogies, before/after Java code, interactive quizzes, and a pattern finder.
      Built for beginners and experienced developers who want clarity without jargon overload.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center sm:justify-start">
      <a href="#patterns" class="rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-indigo-900/40 hover:bg-indigo-500 transition-colors">
        Browse patterns
      </a>
      <a href="#finder" class="rounded-xl border border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-300 hover:border-indigo-500 hover:text-white transition-colors">
        Find a pattern
      </a>
    </div>
  </section>

  <PatternFinder />

  <section id="patterns" class="mt-16 scroll-mt-20">
    <h2 class="text-2xl font-bold text-white">Pattern library</h2>
    <p class="mt-2 text-slate-400">{patterns.length} patterns — more coming soon.</p>

    {
      Object.entries(grouped).map(([category, items]) =>
        items.length > 0 && (
          <div class="mt-10">
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500">
              {categoryLabels[category as keyof typeof categoryLabels]}
            </h3>
            <div class="grid gap-4 sm:grid-cols-2">
              {items.map((pattern) => <PatternCard pattern={pattern} />)}
            </div>
          </div>
        )
      )
    }
  </section>

  <section class="mt-16 rounded-2xl border border-slate-800 bg-slate-900/40 p-6 sm:p-8">
    <h2 class="text-xl font-semibold text-white">How to use this site</h2>
    <ol class="mt-4 space-y-3 text-slate-400 list-decimal list-inside">
      <li>Read the one-liner and real-life analogy first — no code yet.</li>
      <li>Compare <strong class="text-slate-300">without vs with</strong> the pattern in Java.</li>
      <li>Check when to use and when <em>not</em> to use before applying it at work.</li>
      <li>Take the quick quiz to reinforce the idea.</li>
    </ol>
  </section>
</BaseLayout>
