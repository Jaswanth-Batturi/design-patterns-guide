---
import BaseLayout from '../layouts/BaseLayout.astro';
import PatternCard from '../components/PatternCard.astro';
import PatternFinder from '../components/PatternFinder.astro';
import { patterns, categoryLabels, type PatternCategory } from '../data/patterns';
import { sitePath } from '../utils/paths';

const grouped = {
  creational: patterns.filter((p) => p.category === 'creational'),
  structural: patterns.filter((p) => p.category === 'structural'),
  behavioral: patterns.filter((p) => p.category === 'behavioral'),
};

const categories: PatternCategory[] = ['creational', 'structural', 'behavioral'];
---

<BaseLayout title="Design Patterns, Simply">
  <section class="mb-16">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-400">23 patterns · Java</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl leading-tight">
      Know <em class="text-indigo-300 not-italic">when</em> to use each design pattern.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-400">
      Not textbook definitions — everyday situations, what goes wrong without the pattern,
      what gets easier with it, then Java you can run.
    </p>

    <div class="mt-8 grid gap-3 sm:grid-cols-3 max-w-3xl">
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-sm">
        <span class="text-indigo-400 font-bold">1.</span>
        <span class="text-slate-300"> Picture a real-life scene</span>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-sm">
        <span class="text-indigo-400 font-bold">2.</span>
        <span class="text-slate-300"> Compare without vs with</span>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-sm">
        <span class="text-indigo-400 font-bold">3.</span>
        <span class="text-slate-300"> Run code & take a quiz</span>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={sitePath('#patterns')} class="rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-indigo-900/40 hover:bg-indigo-500 transition-colors">
        Browse all 23 patterns
      </a>
      <a href={sitePath('#finder')} class="rounded-xl border border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-300 hover:border-indigo-500 hover:text-white transition-colors">
        Help me pick a pattern
      </a>
    </div>
  </section>

  <PatternFinder />

  <section id="patterns" class="mt-16 scroll-mt-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-white">Pattern library</h2>
        <p class="mt-2 text-slate-400">All 23 Gang of Four patterns — same path on every page: scene → tradeoffs → code → run → quiz.</p>
      </div>
      <label class="flex w-full sm:w-auto min-w-[200px] flex-col gap-1">
        <span class="text-xs font-medium text-slate-500">Search patterns</span>
        <input
          type="search"
          id="pattern-search"
          placeholder="e.g. undo, payment, notify…"
          class="rounded-xl border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-white placeholder:text-slate-600 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </label>
    </div>
    <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter by category" id="category-filters">
      <button type="button" data-filter="all" class="filter-btn rounded-full bg-indigo-600 px-3 py-1 text-xs font-medium text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400" aria-pressed="true">All</button>
      {categories.map((cat) => (
        <button type="button" data-filter={cat} class="filter-btn rounded-full border border-slate-700 px-3 py-1 text-xs font-medium text-slate-400 hover:border-indigo-500 hover:text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500" aria-pressed="false">
          {categoryLabels[cat]}
        </button>
      ))}
    </div>

    {
      Object.entries(grouped).map(([category, items]) =>
        items.length > 0 && (
          <div class="mt-10 pattern-group" data-category={category}>
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500">
              {categoryLabels[category as keyof typeof categoryLabels]}
            </h3>
            <div class="grid gap-4 sm:grid-cols-2">
              {items.map((pattern) => (
                <div class="pattern-card" data-category={pattern.category}>
                  <PatternCard pattern={pattern} />
                </div>
              ))}
            </div>
          </div>
        )
      )
    }
  </section>
</BaseLayout>

<script>
  const filters = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.pattern-card');
  const groups = document.querySelectorAll('.pattern-group');
  const searchInput = document.getElementById('pattern-search');

  const applyVisibility = () => {
    const filterBtn = document.querySelector('.filter-btn[aria-pressed="true"]');
    const filter = filterBtn?.getAttribute('data-filter') ?? 'all';
    const query = (searchInput?.value ?? '').trim().toLowerCase();

    cards.forEach((card) => {
      const cat = card.getAttribute('data-category');
      const text = card.textContent?.toLowerCase() ?? '';
      const matchesFilter = filter === 'all' || cat === filter;
      const matchesSearch = !query || text.includes(query);
      card.classList.toggle('hidden', !matchesFilter || !matchesSearch);
    });

    groups.forEach((group) => {
      const cat = group.getAttribute('data-category');
      const visibleInGroup = Array.from(group.querySelectorAll('.pattern-card')).some(
        (c) => !c.classList.contains('hidden'),
      );
      const matchesFilter = filter === 'all' || cat === filter;
      group.classList.toggle('hidden', !matchesFilter || !visibleInGroup);
    });
  };

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') ?? 'all';

      filters.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('bg-indigo-600', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border', !active);
        b.classList.toggle('border-slate-700', !active);
        b.classList.toggle('text-slate-400', !active);
      });

      applyVisibility();
    });
  });

  searchInput?.addEventListener('input', applyVisibility);
</script>
