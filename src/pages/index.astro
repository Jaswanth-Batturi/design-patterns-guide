---
import BaseLayout from '../layouts/BaseLayout.astro';
import PatternCard from '../components/PatternCard.astro';
import PatternFinder from '../components/PatternFinder.astro';
import { patterns, categoryLabels, type PatternCategory } from '../data/patterns';

const grouped = {
  creational: patterns.filter((p) => p.category === 'creational'),
  structural: patterns.filter((p) => p.category === 'structural'),
  behavioral: patterns.filter((p) => p.category === 'behavioral'),
};

const categories: PatternCategory[] = ['creational', 'structural', 'behavioral'];
---

<BaseLayout title="Design Patterns">
  <header class="mb-10 max-w-xl">
    <p class="text-sm text-slate-500">23 patterns · Java examples</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Learn when to use each pattern
    </h1>
    <p class="mt-3 text-base leading-relaxed text-slate-400">
      Each pattern uses one real-life story, shows the messy code vs the fix, and lets you run a short demo.
    </p>
  </header>

  <section id="patterns" class="scroll-mt-20">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-lg font-semibold text-white">Browse patterns</h2>
      <input
        type="search"
        id="pattern-search"
        placeholder="Search…"
        aria-label="Search patterns"
        class="w-full sm:w-56 rounded-lg border border-slate-800 bg-slate-900/80 px-3 py-2 text-sm text-white placeholder:text-slate-600 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500/40"
      />
    </div>

    <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter by category" id="category-filters">
      <button type="button" data-filter="all" class="filter-btn rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white" aria-pressed="true">All</button>
      {categories.map((cat) => (
        <button type="button" data-filter={cat} class="filter-btn rounded-md border border-slate-800 px-3 py-1.5 text-xs font-medium text-slate-400 hover:text-white hover:border-slate-600 transition-colors" aria-pressed="false">
          {categoryLabels[cat]}
        </button>
      ))}
    </div>

    {
      Object.entries(grouped).map(([category, items]) =>
        items.length > 0 && (
          <div class="mt-8 pattern-group" data-category={category}>
            <h3 class="mb-3 text-xs font-medium uppercase tracking-wider text-slate-500">
              {categoryLabels[category as keyof typeof categoryLabels]}
            </h3>
            <div class="grid gap-3 sm:grid-cols-2">
              {items.map((pattern) => (
                <div class="pattern-card" data-category={pattern.category}>
                  <PatternCard pattern={pattern} />
                </div>
              ))}
            </div>
          </div>
        )
      )
    }
  </section>

  <PatternFinder />
</BaseLayout>

<script>
  const filters = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.pattern-card');
  const groups = document.querySelectorAll('.pattern-group');
  const searchInput = document.getElementById('pattern-search');

  const applyVisibility = () => {
    const filterBtn = document.querySelector('.filter-btn[aria-pressed="true"]');
    const filter = filterBtn?.getAttribute('data-filter') ?? 'all';
    const query = (searchInput?.value ?? '').trim().toLowerCase();

    cards.forEach((card) => {
      const cat = card.getAttribute('data-category');
      const text = card.textContent?.toLowerCase() ?? '';
      const matchesFilter = filter === 'all' || cat === filter;
      const matchesSearch = !query || text.includes(query);
      card.classList.toggle('hidden', !matchesFilter || !matchesSearch);
    });

    groups.forEach((group) => {
      const cat = group.getAttribute('data-category');
      const visibleInGroup = Array.from(group.querySelectorAll('.pattern-card')).some(
        (c) => !c.classList.contains('hidden'),
      );
      const matchesFilter = filter === 'all' || cat === filter;
      group.classList.toggle('hidden', !matchesFilter || !visibleInGroup);
    });
  };

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('bg-indigo-600', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border', !active);
        b.classList.toggle('border-slate-800', !active);
        b.classList.toggle('text-slate-400', !active);
      });
      applyVisibility();
    });
  });

  searchInput?.addEventListener('input', applyVisibility);
</script>
