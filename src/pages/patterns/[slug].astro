---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeToggle from '../../components/CodeToggle.astro';
import Quiz from '../../components/Quiz.astro';
import { patterns, getPattern, categoryLabels } from '../../data/patterns';
import { patternPath, sitePath } from '../../utils/paths';

export function getStaticPaths() {
  return patterns.map((pattern) => ({
    params: { slug: pattern.slug },
    props: { pattern },
  }));
}

const { pattern } = Astro.props;
const related = pattern.relatedPatterns
  .map((slug) => getPattern(slug))
  .filter(Boolean);

const patternIndex = patterns.findIndex((p) => p.slug === pattern.slug);
const prevPattern = patternIndex > 0 ? patterns[patternIndex - 1] : null;
const nextPattern = patternIndex < patterns.length - 1 ? patterns[patternIndex + 1] : null;

const categoryColor: Record<string, string> = {
  creational: 'text-emerald-400',
  structural: 'text-sky-400',
  behavioral: 'text-amber-400',
};
---

<BaseLayout title={pattern.name} description={pattern.oneLiner}>
  <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
    <a href={sitePath()} class="hover:text-indigo-400 transition-colors">Home</a>
    <span class="mx-2">/</span>
    <a href={sitePath('#patterns')} class="hover:text-indigo-400 transition-colors">Patterns</a>
    <span class="mx-2">/</span>
    <span class="text-slate-400">{pattern.name}</span>
  </nav>

  <header class="mb-10">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold text-white sm:text-4xl">{pattern.name}</h1>
      <span class={`text-sm font-medium ${categoryColor[pattern.category]}`}>
        {categoryLabels[pattern.category]}
      </span>
    </div>
    <p class="mt-4 text-lg leading-relaxed text-slate-300">{pattern.oneLiner}</p>
  </header>

  <div class="space-y-10">
    <section class="rounded-2xl border border-slate-800 bg-indigo-950/30 p-6">
      <h2 class="text-lg font-semibold text-indigo-300">Real-life analogy</h2>
      <p class="mt-3 leading-relaxed text-slate-300">{pattern.analogy}</p>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-white">The problem</h2>
      <p class="mt-3 leading-relaxed text-slate-400">{pattern.problem}</p>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-white">The solution</h2>
      <p class="mt-3 leading-relaxed text-slate-400">{pattern.solution}</p>
    </section>

    <section class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-emerald-500/20 bg-emerald-950/20 p-5">
        <h2 class="font-semibold text-emerald-400">When to use</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          {pattern.whenToUse.map((item) => (
            <li class="flex gap-2">
              <span class="text-emerald-500 shrink-0">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border border-rose-500/20 bg-rose-950/20 p-5">
        <h2 class="font-semibold text-rose-400">When not to use</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          {pattern.whenNotToUse.map((item) => (
            <li class="flex gap-2">
              <span class="text-rose-500 shrink-0">✗</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-white">Java code</h2>
      <p class="mt-2 text-sm text-slate-400">Toggle between messy code and the pattern applied.</p>
      <div class="mt-4">
        <CodeToggle before={pattern.codeBefore} after={pattern.codeAfter} />
      </div>
    </section>

    <Quiz questions={pattern.quiz} patternName={pattern.name} />

    {
      related.length > 0 && (
        <section>
          <h2 class="text-xl font-semibold text-white">Related patterns</h2>
          <div class="mt-4 flex flex-wrap gap-3">
            {related.map((p) => (
              <a
                href={patternPath(p!.slug)}
                class="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:border-indigo-500 hover:text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
              >
                {p!.name} →
              </a>
            ))}
          </div>
        </section>
      )
    }

    <nav class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-800 pt-8" aria-label="Pattern navigation">
      {
        prevPattern ? (
          <a
            href={patternPath(prevPattern.slug)}
            class="text-sm text-slate-400 hover:text-indigo-300 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
          >
            ← {prevPattern.name}
          </a>
        ) : (
          <span />
        )
      }
      {
        nextPattern && (
          <a
            href={patternPath(nextPattern.slug)}
            class="text-sm text-slate-400 hover:text-indigo-300 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
          >
            {nextPattern.name} →
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>
