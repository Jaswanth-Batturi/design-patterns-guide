---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeToggle from '../../components/CodeToggle.astro';
import Quiz from '../../components/Quiz.astro';
import PatternStory from '../../components/PatternStory.astro';
import TradeoffCompare from '../../components/TradeoffCompare.astro';
import CodeRunner from '../../components/CodeRunner.astro';
import { patterns, getPattern, categoryLabels } from '../../data/patterns';
import { enrichPattern } from '../../data/patterns/enrich';
import { patternPath, sitePath } from '../../utils/paths';

export function getStaticPaths() {
  return patterns.map((pattern) => ({
    params: { slug: pattern.slug },
    props: { pattern: enrichPattern(pattern) },
  }));
}

const pattern = Astro.props.pattern;
const related = pattern.relatedPatterns.map((slug) => getPattern(slug)).filter(Boolean);

const patternIndex = patterns.findIndex((p) => p.slug === pattern.slug);
const prevPattern = patternIndex > 0 ? patterns[patternIndex - 1] : null;
const nextPattern = patternIndex < patterns.length - 1 ? patterns[patternIndex + 1] : null;

const categoryColor: Record<string, string> = {
  creational: 'text-emerald-400/90',
  structural: 'text-sky-400/90',
  behavioral: 'text-amber-400/90',
};

const sections = [
  { id: 'story', label: 'Analogy' },
  { id: 'tradeoffs', label: 'In your code' },
  { id: 'decision', label: 'When to use' },
  { id: 'code', label: 'Code' },
  { id: 'run', label: 'Run it' },
  { id: 'quiz', label: 'Quiz' },
];
---

<BaseLayout title={pattern.name} description={pattern.oneLiner}>
  <nav class="mb-5 text-sm text-slate-500" aria-label="Breadcrumb">
    <a href={sitePath()} class="hover:text-indigo-400 transition-colors">Home</a>
    <span class="mx-2">/</span>
    <a href={sitePath('#patterns')} class="hover:text-indigo-400 transition-colors">Patterns</a>
    <span class="mx-2">/</span>
    <span class="text-slate-400">{pattern.name}</span>
  </nav>

  <header class="mb-6 max-w-2xl">
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <span class={`font-medium ${categoryColor[pattern.category]}`}>{categoryLabels[pattern.category]}</span>
    </div>
    <h1 class="mt-2 text-2xl font-bold text-white sm:text-3xl">{pattern.name}</h1>
    <p class="mt-2 text-base text-slate-400">{pattern.oneLiner}</p>
  </header>

  <nav
    class="sticky top-[52px] z-40 -mx-4 mb-6 flex gap-2 overflow-x-auto border-b border-slate-800 bg-slate-950/95 px-4 py-2.5 backdrop-blur-md sm:mx-0"
    aria-label="Page sections"
  >
    {sections.map((s) => (
      <a
        href={`#${s.id}`}
        class="section-jump shrink-0 rounded-md px-3 py-1 text-xs font-medium text-slate-500 hover:text-white transition-colors"
      >
        {s.label}
      </a>
    ))}
  </nav>

  <div class="space-y-8">
    <div id="story" class="scroll-mt-36">
      <PatternStory slug={pattern.slug} icon={pattern.analogyIcon} steps={pattern.sceneSteps} />
    </div>

    <div id="tradeoffs" class="scroll-mt-36">
      <TradeoffCompare withoutPains={pattern.withoutPatternPains} withWins={pattern.withPatternWins} />
    </div>

    <details id="decision" class="scroll-mt-36 rounded-xl border border-slate-800 bg-slate-900/30 px-4 py-3" open>
      <summary class="cursor-pointer text-sm font-medium text-slate-300 select-none">When to use or skip</summary>
      <div class="mt-3 grid gap-4 sm:grid-cols-2 text-sm text-slate-500">
        <div>
          <p class="mb-2 text-xs font-medium uppercase tracking-wide text-emerald-400/80">Use when</p>
          <ul class="space-y-1.5">
            {pattern.whenToUse.map((item) => (
              <li>+ {item}</li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mb-2 text-xs font-medium uppercase tracking-wide text-rose-400/80">Skip when</p>
          <ul class="space-y-1.5">
            {pattern.whenNotToUse.map((item) => (
              <li>− {item}</li>
            ))}
          </ul>
        </div>
      </div>
    </details>

    <div id="code" class="scroll-mt-36">
      <CodeToggle
        before={pattern.displayCodeBefore}
        after={pattern.displayCodeAfter}
        takeaway={pattern.codeTakeaway}
        beforeHint={pattern.codeBeforeHint}
        afterHint={pattern.codeAfterHint}
        defaultView="before"
      />
    </div>

    <div id="run" class="scroll-mt-36">
      <CodeRunner code={pattern.runDemo} runExpect={pattern.runExpect} tryItSteps={pattern.tryItSteps} />
    </div>

    <div id="quiz" class="scroll-mt-36">
      <Quiz questions={pattern.quiz} />
    </div>

    {
      related.length > 0 && (
        <section class="border-t border-slate-800 pt-6">
          <h2 class="text-sm font-medium text-slate-400">Related</h2>
          <div class="mt-2 flex flex-wrap gap-2">
            {related.map((p) => (
              <a
                href={patternPath(p!.slug)}
                class="rounded-md border border-slate-800 px-2.5 py-1 text-sm text-slate-500 hover:border-slate-600 hover:text-white transition-colors"
              >
                {p!.name}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <nav class="flex justify-between gap-4 border-t border-slate-800 pt-5 text-sm text-slate-500" aria-label="Pattern navigation">
      {prevPattern ? (
        <a href={patternPath(prevPattern.slug)} class="hover:text-indigo-300">← {prevPattern.name}</a>
      ) : (
        <span />
      )}
      {nextPattern && (
        <a href={patternPath(nextPattern.slug)} class="hover:text-indigo-300">{nextPattern.name} →</a>
      )}
    </nav>
  </div>
</BaseLayout>

<script>
  const nav = document.querySelector('nav[aria-label="Page sections"]');
  const links = nav?.querySelectorAll('.section-jump');
  const ids = ['story', 'tradeoffs', 'decision', 'code', 'run', 'quiz'];

  const sync = () => {
    if (!links) return;
    let active = ids[0];
    for (const id of ids) {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top <= 120) active = id;
    }
    links.forEach((link) => {
      const on = link.getAttribute('href') === `#${active}`;
      link.classList.toggle('text-white', on);
      link.classList.toggle('bg-indigo-600/30', on);
      link.classList.toggle('text-slate-500', !on);
    });
  };

  window.addEventListener('scroll', sync, { passive: true });
  sync();
</script>
