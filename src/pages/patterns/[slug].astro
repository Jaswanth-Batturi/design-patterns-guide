---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeToggle from '../../components/CodeToggle.astro';
import Quiz from '../../components/Quiz.astro';
import SceneVisual from '../../components/SceneVisual.astro';
import TradeoffCompare from '../../components/TradeoffCompare.astro';
import CodeRunner from '../../components/CodeRunner.astro';
import { patterns, getPattern, categoryLabels, categoryHints } from '../../data/patterns';
import { enrichPattern } from '../../data/patterns/enrich';
import { patternPath, sitePath } from '../../utils/paths';

export function getStaticPaths() {
  return patterns.map((pattern) => ({
    params: { slug: pattern.slug },
    props: { pattern: enrichPattern(pattern) },
  }));
}

const pattern = Astro.props.pattern;
const related = pattern.relatedPatterns
  .map((slug) => getPattern(slug))
  .filter(Boolean);

const patternIndex = patterns.findIndex((p) => p.slug === pattern.slug);
const prevPattern = patternIndex > 0 ? patterns[patternIndex - 1] : null;
const nextPattern = patternIndex < patterns.length - 1 ? patterns[patternIndex + 1] : null;

const categoryColor: Record<string, string> = {
  creational: 'text-emerald-400',
  structural: 'text-sky-400',
  behavioral: 'text-amber-400',
};

const sectionLinks = [
  { id: 'scene', label: 'Real life' },
  { id: 'tradeoffs', label: 'Tradeoffs' },
  { id: 'decision', label: 'When to use' },
  { id: 'code', label: 'Code' },
  { id: 'try-it', label: 'Try it' },
  { id: 'quiz', label: 'Quiz' },
];
---

<BaseLayout title={pattern.name} description={pattern.oneLiner}>
  <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
    <a href={sitePath()} class="hover:text-indigo-400 transition-colors">Home</a>
    <span class="mx-2">/</span>
    <a href={sitePath('#patterns')} class="hover:text-indigo-400 transition-colors">Library</a>
    <span class="mx-2">/</span>
    <span class="text-slate-400">{pattern.name}</span>
  </nav>

  <header class="mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-3xl" aria-hidden="true">{pattern.analogyIcon}</span>
      <h1 class="text-3xl font-bold text-white sm:text-4xl">{pattern.name}</h1>
      <span class={`text-sm font-medium ${categoryColor[pattern.category]}`}>
        {categoryLabels[pattern.category]} · {categoryHints[pattern.category]}
      </span>
    </div>
    <p class="mt-4 text-xl leading-relaxed text-slate-200">{pattern.oneLiner}</p>
  </header>

  <nav
    class="sticky top-[65px] z-40 -mx-4 mb-8 flex gap-2 overflow-x-auto border-b border-slate-800 bg-slate-950/95 px-4 py-3 backdrop-blur-md sm:mx-0 sm:rounded-xl sm:border sm:px-3"
    aria-label="Page sections"
  >
    {sectionLinks.map((link, i) => (
      <a
        href={`#${link.id}`}
        class="section-jump shrink-0 rounded-full border border-slate-700 px-3 py-1 text-xs font-medium text-slate-400 transition-colors hover:border-indigo-500 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
      >
        {i + 1}. {link.label}
      </a>
    ))}
  </nav>

  <div class="space-y-12">
    <div id="scene" class="scroll-mt-36">
      <SceneVisual icon={pattern.analogyIcon} title={pattern.name} steps={pattern.sceneSteps} />
    </div>

    <div id="tradeoffs" class="scroll-mt-36">
      <TradeoffCompare withoutPains={pattern.withoutPatternPains} withWins={pattern.withPatternWins} />
    </div>

    <section id="decision" class="scroll-mt-36 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-slate-700/80 bg-slate-900/40 p-5">
        <h2 class="font-semibold text-white">Use it when…</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          {pattern.whenToUse.map((item) => (
            <li class="flex gap-2">
              <span class="text-emerald-500 shrink-0">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border border-slate-700/80 bg-slate-900/40 p-5">
        <h2 class="font-semibold text-white">Skip it when…</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          {pattern.whenNotToUse.map((item) => (
            <li class="flex gap-2">
              <span class="text-rose-500 shrink-0">✗</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div id="code" class="scroll-mt-36">
      <CodeToggle
        before={pattern.codeBefore}
        after={pattern.codeAfter}
        takeaway={pattern.codeTakeaway}
        beforeHint={pattern.codeBeforeHint}
        afterHint={pattern.codeAfterHint}
        defaultView="before"
      />
    </div>

    <div id="try-it" class="scroll-mt-36">
      <CodeRunner code={pattern.runDemo} patternName={pattern.name} steps={pattern.tryItSteps} />
    </div>

    <div id="quiz" class="scroll-mt-36">
      <Quiz questions={pattern.quiz} patternName={pattern.name} />
    </div>

    {
      related.length > 0 && (
        <section class="scroll-mt-36">
          <h2 class="text-xl font-semibold text-white">Often confused with…</h2>
          <p class="mt-1 text-sm text-slate-500">Related patterns worth comparing next.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            {related.map((p) => (
              <a
                href={patternPath(p!.slug)}
                class="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:border-indigo-500 hover:text-white transition-colors"
              >
                {p!.name} →
              </a>
            ))}
          </div>
        </section>
      )
    }

    <nav class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-800 pt-8" aria-label="Pattern navigation">
      {
        prevPattern ? (
          <a href={patternPath(prevPattern.slug)} class="text-sm text-slate-400 hover:text-indigo-300 transition-colors">
            ← {prevPattern.name}
          </a>
        ) : (
          <span />
        )
      }
      {
        nextPattern && (
          <a href={patternPath(nextPattern.slug)} class="text-sm text-slate-400 hover:text-indigo-300 transition-colors">
            {nextPattern.name} →
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .section-jump[aria-current='true'] {
    border-color: rgb(99 102 241);
    background: rgb(79 70 229 / 0.25);
    color: white;
  }
</style>

<script>
  const nav = document.querySelector('nav[aria-label="Page sections"]');
  const links = nav?.querySelectorAll('.section-jump');
  const ids = ['scene', 'tradeoffs', 'decision', 'code', 'try-it', 'quiz'];

  const syncActive = () => {
    if (!links) return;
    let active = ids[0];
    const offset = 140;
    for (const id of ids) {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top <= offset) active = id;
    }
    links.forEach((link) => {
      const href = link.getAttribute('href')?.slice(1);
      link.setAttribute('aria-current', href === active ? 'true' : 'false');
    });
  };

  window.addEventListener('scroll', syncActive, { passive: true });
  syncActive();
</script>
