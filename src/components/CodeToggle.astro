---
import { highlightJava } from '../utils/highlight';

interface Props {
  before: string;
  after: string;
  takeaway: string;
  beforeHint?: string;
  afterHint?: string;
  defaultView?: 'before' | 'after';
}

const { before, after, takeaway, beforeHint, afterHint, defaultView = 'before' } = Astro.props;
const id = `code-${Math.random().toString(36).slice(2, 9)}`;
const beforeHtml = await highlightJava(before);
const afterHtml = await highlightJava(after);
---

<section class="space-y-3">
  <div>
    <h2 class="text-xl font-semibold text-white">See the difference in code</h2>
    <p class="mt-2 text-sm text-slate-400">{takeaway}</p>
  </div>

  <div class="code-toggle rounded-2xl border border-slate-800 bg-slate-900/60 overflow-hidden" data-code-toggle={id} data-before-raw={before} data-after-raw={after}>
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 px-4 py-3 bg-slate-900/80">
      <div class="flex gap-2" role="tablist" aria-label="Code comparison">
        <button
          type="button"
          data-view="before"
          role="tab"
          class="code-tab rounded-lg px-3 py-1.5 text-sm font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-400"
          aria-pressed={defaultView === 'before' ? 'true' : 'false'}
          aria-selected={defaultView === 'before' ? 'true' : 'false'}
        >
          😣 Without pattern
        </button>
        <button
          type="button"
          data-view="after"
          role="tab"
          class="code-tab rounded-lg px-3 py-1.5 text-sm font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400"
          aria-pressed={defaultView === 'after' ? 'true' : 'false'}
          aria-selected={defaultView === 'after' ? 'true' : 'false'}
        >
          ✅ With pattern
        </button>
      </div>
      <button
        type="button"
        data-copy
        class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 hover:border-indigo-500 hover:text-white transition-colors"
      >
        Copy code
      </button>
    </div>
    <p data-hint="before" class={`border-b border-rose-500/20 bg-rose-950/20 px-4 py-2 text-xs text-rose-200/90 ${defaultView === 'before' ? '' : 'hidden'}`}>
      {beforeHint ?? 'Notice: tight coupling, hard to extend, one change forces many edits.'}
    </p>
    <p data-hint="after" class={`border-b border-emerald-500/20 bg-emerald-950/20 px-4 py-2 text-xs text-emerald-200/90 ${defaultView === 'after' ? '' : 'hidden'}`}>
      {afterHint ?? 'Notice: roles are separated — you can add new behavior without breaking old code.'}
    </p>
    <div data-panel="before" class={`highlighted-panel ${defaultView === 'before' ? '' : 'hidden'}`} aria-hidden={defaultView !== 'before' ? 'true' : 'false'}>
      <div class="highlighted-code overflow-x-auto text-sm leading-relaxed" set:html={beforeHtml} />
    </div>
    <div data-panel="after" class={`highlighted-panel ${defaultView === 'after' ? '' : 'hidden'}`} aria-hidden={defaultView !== 'after' ? 'true' : 'false'}>
      <div class="highlighted-code overflow-x-auto text-sm leading-relaxed" set:html={afterHtml} />
    </div>
  </div>
</section>

<style>
  .highlighted-panel :global(pre) {
    margin: 0;
    padding: 1rem;
    background: transparent !important;
    overflow-x: auto;
  }
  .highlighted-panel :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
</style>

<script define:vars={{ defaultView }}>
  document.querySelectorAll('[data-code-toggle]').forEach((root) => {
    const beforePanel = root.querySelector('[data-panel="before"]');
    const afterPanel = root.querySelector('[data-panel="after"]');
    const hintBefore = root.querySelector('[data-hint="before"]');
    const hintAfter = root.querySelector('[data-hint="after"]');
    const tabs = root.querySelectorAll('.code-tab');
    const copyBtn = root.querySelector('[data-copy]');

    let active = defaultView ?? 'before';

    const getActiveText = () => {
      const raw = active === 'before' ? root.getAttribute('data-before-raw') : root.getAttribute('data-after-raw');
      return raw ?? '';
    };

    const show = (view: string) => {
      active = view;
      beforePanel?.classList.toggle('hidden', view !== 'before');
      afterPanel?.classList.toggle('hidden', view !== 'after');
      beforePanel?.setAttribute('aria-hidden', view !== 'before' ? 'true' : 'false');
      afterPanel?.setAttribute('aria-hidden', view !== 'after' ? 'true' : 'false');
      hintBefore?.classList.toggle('hidden', view !== 'before');
      hintAfter?.classList.toggle('hidden', view !== 'after');
      tabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-view') === view;
        const isBefore = tab.getAttribute('data-view') === 'before';
        tab.setAttribute('aria-pressed', String(isActive));
        tab.setAttribute('aria-selected', String(isActive));
        tab.classList.toggle('bg-rose-600/80', isActive && isBefore);
        tab.classList.toggle('bg-emerald-600/80', isActive && !isBefore);
        tab.classList.toggle('text-white', isActive);
        tab.classList.toggle('text-slate-400', !isActive);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => show(tab.getAttribute('data-view') ?? 'after'));
    });

    show(defaultView ?? 'before');

    copyBtn?.addEventListener('click', async () => {
      const text = getActiveText();
      if (!text) return;
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          ok = document.execCommand('copy');
          document.body.removeChild(ta);
        } catch {
          ok = false;
        }
      }
      copyBtn.textContent = ok ? 'Copied!' : 'Copy failed';
      setTimeout(() => {
        copyBtn.textContent = 'Copy code';
      }, 1500);
    });
  });
</script>
