---
import HighlightedCode from './HighlightedCode.astro';
import { highlightJava } from '../utils/highlight';

interface Props {
  before: string;
  after: string;
}

const { before, after } = Astro.props;
const id = `code-${Math.random().toString(36).slice(2, 9)}`;
const beforeHtml = await highlightJava(before);
const afterHtml = await highlightJava(after);
---

<div class="code-toggle rounded-2xl border border-slate-800 bg-slate-900/60 overflow-hidden" data-code-toggle={id} data-before-raw={before} data-after-raw={after}>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 px-4 py-3">
    <div class="flex gap-2" role="tablist" aria-label="Code comparison">
      <button
        type="button"
        data-view="before"
        role="tab"
        class="code-tab rounded-lg px-3 py-1.5 text-sm font-medium text-slate-400 hover:text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
        aria-pressed="false"
        aria-selected="false"
      >
        Without pattern
      </button>
      <button
        type="button"
        data-view="after"
        role="tab"
        class="code-tab rounded-lg px-3 py-1.5 text-sm font-medium text-slate-400 hover:text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
        aria-pressed="true"
        aria-selected="true"
      >
        With pattern
      </button>
    </div>
    <button
      type="button"
      data-copy
      class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 hover:border-indigo-500 hover:text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
    >
      Copy code
    </button>
  </div>
  <div data-panel="before" class="hidden highlighted-panel" aria-hidden="true">
    <div class="highlighted-code overflow-x-auto text-sm leading-relaxed" set:html={beforeHtml} />
  </div>
  <div data-panel="after" class="highlighted-panel" aria-hidden="false">
    <div class="highlighted-code overflow-x-auto text-sm leading-relaxed" set:html={afterHtml} />
  </div>
</div>

<style>
  .highlighted-panel :global(pre) {
    margin: 0;
    padding: 1rem;
    background: transparent !important;
    overflow-x: auto;
  }
  .highlighted-panel :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
</style>

<script>
  document.querySelectorAll('[data-code-toggle]').forEach((root) => {
    const beforePanel = root.querySelector('[data-panel="before"]');
    const afterPanel = root.querySelector('[data-panel="after"]');
    const tabs = root.querySelectorAll('.code-tab');
    const copyBtn = root.querySelector('[data-copy]');

    let active = 'after';

    const getActiveText = () => {
      const raw = active === 'before' ? root.getAttribute('data-before-raw') : root.getAttribute('data-after-raw');
      return raw ?? '';
    };

    const show = (view: string) => {
      active = view;
      beforePanel?.classList.toggle('hidden', view !== 'before');
      afterPanel?.classList.toggle('hidden', view !== 'after');
      beforePanel?.setAttribute('aria-hidden', view !== 'before' ? 'true' : 'false');
      afterPanel?.setAttribute('aria-hidden', view !== 'after' ? 'true' : 'false');
      tabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-view') === view;
        tab.setAttribute('aria-pressed', String(isActive));
        tab.setAttribute('aria-selected', String(isActive));
        tab.classList.toggle('bg-indigo-600', isActive);
        tab.classList.toggle('text-white', isActive);
        tab.classList.toggle('text-slate-400', !isActive);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => show(tab.getAttribute('data-view') ?? 'after'));
    });

    show('after');

    copyBtn?.addEventListener('click', async () => {
      const text = getActiveText();
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = 'Copied!';
      } catch {
        copyBtn.textContent = 'Copy failed';
      }
      setTimeout(() => {
        copyBtn.textContent = 'Copy code';
      }, 1500);
    });
  });
</script>
