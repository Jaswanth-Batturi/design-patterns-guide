---
import { finderRules, patterns } from '../data/patterns';
import { patternPath } from '../utils/paths';

const examples = [
  { label: 'Notify listeners', text: 'I need to notify email, SMS, and push when order status changes' },
  { label: 'Payment methods', text: 'Checkout supports card, UPI, and cash payment methods' },
  { label: 'Undo actions', text: 'I need command objects with undo and redo for user actions' },
  { label: 'Adapter legacy', text: 'Adapt an old legacy API to our new interface' },
  { label: 'Facade API', text: 'One simple facade over a complex payment subsystem' },
  { label: 'State machine', text: 'Object behavior changes based on traffic light states' },
  { label: 'Flyweight cache', text: 'Share flyweight objects to save memory for repeated glyphs' },
];

const patternUrls = Object.fromEntries(patterns.map((p) => [p.slug, patternPath(p.slug)]));
---

<section id="finder" class="scroll-mt-20">
  <div class="rounded-2xl border border-indigo-500/30 bg-gradient-to-br from-indigo-950/50 to-slate-900/80 p-6 sm:p-8">
    <h2 class="text-2xl font-bold text-white">Which pattern do I need?</h2>
    <p class="mt-2 max-w-2xl text-slate-400">
      Describe your problem in plain English. We match keywords to patterns — a starting point, not a final answer.
    </p>
    <div class="mt-6">
      <label for="finder-input" class="block text-sm font-medium text-slate-300">Your situation</label>
      <textarea
        id="finder-input"
        rows="3"
        placeholder="e.g. I need to notify email, SMS, and push when order status changes..."
        class="mt-2 w-full rounded-xl border border-slate-700 bg-slate-950/80 px-4 py-3 text-slate-200 placeholder:text-slate-600 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30"
      ></textarea>
    </div>
    <div class="mt-3 flex flex-wrap gap-2" aria-label="Example scenarios">
      {examples.map((ex) => (
        <button
          type="button"
          data-example={ex.text}
          class="example-chip rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-400 hover:border-indigo-500 hover:text-indigo-300 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
        >
          {ex.label}
        </button>
      ))}
    </div>
    <div id="finder-results" class="mt-6 space-y-3" aria-live="polite"></div>
  </div>
</section>

<script define:vars={{ finderRules, patterns, patternUrls }}>
  const input = document.getElementById('finder-input');
  const results = document.getElementById('finder-results');

  const scoreRules = (text) => {
    const lower = text.toLowerCase();
    return finderRules
      .map((rule) => {
        const hits = rule.keywords.filter((kw) => lower.includes(kw));
        return { rule, score: hits.length, hits };
      })
      .filter((item) => item.score > 0)
      .sort((a, b) => b.score - a.score);
  };

  const render = () => {
    const text = input?.value.trim() ?? '';
    results.innerHTML = '';

    if (!text) return;

    const matches = scoreRules(text);

    if (matches.length === 0) {
      results.innerHTML =
        '<p class="text-sm text-slate-400">No strong match yet. Try an example above or words like notify, payment, factory, singleton, or wrap.</p>';
      return;
    }

    matches.slice(0, 3).forEach(({ rule, hits }) => {
      const pattern = patterns.find((p) => p.slug === rule.patternSlug);
      if (!pattern) return;

      const card = document.createElement('a');
      card.href = patternUrls[rule.patternSlug];
      card.className =
        'block rounded-xl border border-slate-700 bg-slate-950/60 p-4 transition hover:border-indigo-500/50 hover:bg-slate-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500';
      card.innerHTML = `
        <div class="flex items-center justify-between gap-2">
          <span class="font-semibold text-white">${pattern.name}</span>
          <span class="text-xs text-indigo-400">View pattern →</span>
        </div>
        <p class="mt-1 text-sm text-slate-400">${rule.hint}</p>
        <p class="mt-2 text-xs text-slate-500">Matched: ${hits.join(', ')}</p>
      `;
      results.appendChild(card);
    });
  };

  input?.addEventListener('input', render);

  document.querySelectorAll('[data-example]').forEach((chip) => {
    chip.addEventListener('click', () => {
      if (!input) return;
      input.value = chip.getAttribute('data-example') ?? '';
      input.focus();
      render();
    });
  });
</script>
