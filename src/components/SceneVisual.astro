---
interface Props {
  icon: string;
  title: string;
  steps: string[];
}

const { icon, title, steps } = Astro.props;
const labels = ['Everyday moment', 'What happens', 'Why it maps to code'];
---

<section class="rounded-2xl border border-slate-700/80 bg-gradient-to-b from-slate-900/60 to-slate-950/40 p-5 sm:p-6" aria-label="Real-life scene">
  <div class="flex items-center gap-2 text-sm font-semibold text-indigo-300">
    <span class="text-lg" aria-hidden="true">🌍</span>
    Picture this in real life
  </div>
  <p class="mt-1 text-sm text-slate-400">
    Before the Java — a scene from daily life that matches <span class="text-slate-300">{title}</span>.
  </p>

  <div class="mt-5 flex flex-col gap-0 sm:flex-row sm:items-stretch sm:gap-3">
    {steps.map((step, i) => (
      <div class="flex flex-1 flex-col items-center gap-2 min-w-0">
        <div
          class="scene-card w-full rounded-xl border border-slate-700 bg-slate-950/80 p-4 text-center min-h-[120px] flex flex-col"
          style={`animation-delay: ${i * 120}ms`}
        >
          <span class="text-[10px] font-semibold uppercase tracking-wider text-indigo-400/80">
            {labels[i] ?? `Step ${i + 1}`}
          </span>
          <span class="my-2 block text-3xl" aria-hidden="true">{i === 0 ? icon : i === steps.length - 1 ? '✨' : '→'}</span>
          <p class="text-sm leading-relaxed text-slate-300 flex-1">{step}</p>
        </div>
        {i < steps.length - 1 && (
          <span class="hidden sm:block text-slate-600 text-lg py-1" aria-hidden="true">→</span>
        )}
        {i < steps.length - 1 && (
          <span class="sm:hidden text-slate-600 text-sm py-1" aria-hidden="true">↓</span>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .scene-card {
    animation: scene-in 0.5s ease-out both;
  }
  @keyframes scene-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-card {
      animation: none;
    }
  }
</style>
