---
interface Props {
  icon: string;
  title: string;
  steps: string[];
}

const { icon, title, steps } = Astro.props;
---

<section class="rounded-2xl border border-slate-700/80 bg-slate-900/50 p-5 sm:p-6" aria-label="Real-life scene">
  <div class="flex items-center gap-2 text-sm font-semibold text-indigo-300">
    <span class="text-lg" aria-hidden="true">🌍</span>
    Picture this in real life
  </div>
  <p class="mt-1 text-xs text-slate-500">{title}</p>

  <div class="mt-5 flex flex-col gap-0 sm:flex-row sm:items-stretch sm:gap-3">
    {steps.map((step, i) => (
      <div class="flex flex-1 flex-col items-center gap-2 min-w-0">
        <div
          class="scene-card w-full rounded-xl border border-slate-700 bg-slate-950/80 p-4 text-center text-sm leading-relaxed text-slate-300"
          style={`animation-delay: ${i * 120}ms`}
        >
          <span class="mb-2 block text-2xl" aria-hidden="true">{i === 0 ? icon : i === steps.length - 1 ? '✨' : '→'}</span>
          {step}
        </div>
        {i < steps.length - 1 && (
          <span class="hidden sm:block text-slate-600 text-lg py-1" aria-hidden="true">→</span>
        )}
        {i < steps.length - 1 && (
          <span class="sm:hidden text-slate-600 text-sm py-1" aria-hidden="true">↓</span>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .scene-card {
    animation: scene-in 0.5s ease-out both;
  }
  @keyframes scene-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-card {
      animation: none;
    }
  }
</style>
