---
interface Props {
  icon: string;
  steps: [string, string, string];
}

const { icon, steps } = Astro.props;
const labels: [string, string, string] = ['Situation', 'Without it', 'The fix'];
---

<section class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5 sm:p-6" aria-label="Real-life scene">
  <h2 class="text-lg font-semibold text-white">
    <span class="mr-2" aria-hidden="true">{icon}</span>
    Start with real life
  </h2>
  <p class="mt-1 text-sm text-slate-400">Same story in the next sections — in code.</p>

  <ol class="mt-5 grid gap-3 sm:grid-cols-3 sm:gap-4 list-none">
    {steps.map((step, i) => (
      <li
        class="scene-card flex flex-col rounded-xl border border-slate-700/80 bg-slate-950/60 p-4 sm:p-5 h-full min-h-[132px]"
        style={`animation-delay: ${i * 80}ms`}
      >
        <div class="flex items-center gap-2">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-xs font-bold text-white">
            {i + 1}
          </span>
          <span class="text-xs font-semibold uppercase tracking-wide text-indigo-300/90">{labels[i]}</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-300">{step}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .scene-card {
    animation: scene-in 0.4s ease-out both;
  }
  @keyframes scene-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-card {
      animation: none;
    }
  }
</style>
