---
import { javaToCompilerFiles, javaMainClassName } from '../utils/java-files';

interface Props {
  code: string;
  runExpect: string;
}

const { code, runExpect } = Astro.props;
const frameId = `oc-runner-${Math.random().toString(36).slice(2, 9)}`;
const files = javaToCompilerFiles(code);
const embedSrc =
  'https://onecompiler.com/embed/java?listenToEvents=true&hideLanguageSelection=true&theme=dark&hideTitle=true&hideNewFileOption=true';
---

<section class="rounded-2xl border border-slate-800 bg-slate-900/40 overflow-hidden" data-code-runner>
  <div class="border-b border-slate-800 px-4 py-4 sm:px-5">
    <h3 class="text-base font-semibold text-white">Run it</h3>
    <p class="mt-2 text-sm text-slate-400">
      Click <span class="font-medium text-emerald-400">Run ▶</span> inside the editor below.
      Expect: <span class="text-slate-300">{runExpect}</span>
    </p>
  </div>

  <div class="flex items-center justify-between gap-2 border-b border-slate-800 px-4 py-2">
    <span data-runner-status class="text-xs text-slate-500" role="status">Loading editor…</span>
    <a
      href="https://onecompiler.com/java"
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs text-indigo-400 hover:text-indigo-300"
    >
      Open full editor ↗
    </a>
  </div>

  <div class="relative min-h-[420px] bg-[#1e1e1e]">
    <div
      data-runner-loading
      class="absolute inset-0 z-10 flex items-center justify-center text-sm text-slate-400 bg-slate-950"
    >
      <span class="inline-block h-7 w-7 animate-spin rounded-full border-2 border-indigo-500 border-t-transparent" aria-hidden="true"></span>
    </div>
    <iframe
      id={frameId}
      title="Java code runner"
      src={embedSrc}
      class="w-full min-h-[420px] border-0 bg-[#1e1e1e] opacity-0 transition-opacity duration-500"
      data-oc-frame
      loading="lazy"
      allow="clipboard-write"
    ></iframe>
  </div>
</section>

<script define:vars={{ frameId, files }}>
  const iframe = document.getElementById(frameId);
  const section = iframe?.closest('[data-code-runner]');
  const loading = section?.querySelector('[data-runner-loading]');
  const status = section?.querySelector('[data-runner-status]');
  let populated = false;

  const populateEditor = () => {
    if (!iframe || populated) return;
    populated = true;
    iframe.contentWindow?.postMessage({ eventType: 'populateCode', language: 'java', files }, '*');
    loading?.classList.add('hidden');
    iframe.classList.remove('opacity-0');
    iframe.classList.add('opacity-100');
    if (status) {
      status.textContent = 'Ready — Run ▶ is inside the editor';
      status.classList.add('text-emerald-400/90');
    }
  };

  if (iframe) {
    iframe.addEventListener('load', () => {
      setTimeout(populateEditor, 600);
      setTimeout(populateEditor, 2000);
    });
  }
</script>
