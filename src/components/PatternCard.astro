---
import type { Pattern } from '../data/patterns';
import { categoryLabels } from '../data/patterns';
import { patternPath } from '../utils/paths';

interface Props {
  pattern: Pattern;
}

const { pattern } = Astro.props;
const href = patternPath(pattern.slug);
const categoryColor: Record<string, string> = {
  creational: 'text-emerald-400/90',
  structural: 'text-sky-400/90',
  behavioral: 'text-amber-400/90',
};
---

<a
  href={href}
  class="group block rounded-xl border border-slate-800/80 bg-slate-900/40 p-4 transition hover:border-slate-600 hover:bg-slate-900/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
>
  <div class="flex items-start gap-3">
    <span class="text-xl leading-none shrink-0" aria-hidden="true">{pattern.analogyIcon}</span>
    <div class="min-w-0 flex-1">
      <div class="flex items-center justify-between gap-2">
        <h3 class="font-medium text-white group-hover:text-indigo-300 transition-colors">{pattern.name}</h3>
        <span class={`text-[10px] font-medium uppercase tracking-wide shrink-0 ${categoryColor[pattern.category]}`}>
          {categoryLabels[pattern.category]}
        </span>
      </div>
      <p class="mt-1.5 text-sm leading-snug text-slate-500">{pattern.oneLiner}</p>
    </div>
  </div>
</a>
