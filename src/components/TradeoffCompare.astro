---
interface Props {
  withoutPains: [string, string, string];
  withWins: [string, string, string];
}

const { withoutPains, withWins } = Astro.props;
---

<section aria-labelledby="tradeoff-heading">
  <h2 id="tradeoff-heading" class="text-base font-semibold text-white">In your code</h2>
  <p class="mt-0.5 text-sm text-slate-500">Same three ideas — without vs with the pattern.</p>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
      <h3 class="text-xs font-medium uppercase tracking-wide text-rose-400/90">Without</h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-400">
        {withoutPains.map((item, i) => (
          <li class="flex gap-2">
            <span class="text-slate-600 shrink-0">{i + 1}.</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
      <h3 class="text-xs font-medium uppercase tracking-wide text-emerald-400/90">With pattern</h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-400">
        {withWins.map((item, i) => (
          <li class="flex gap-2">
            <span class="text-slate-600 shrink-0">{i + 1}.</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
