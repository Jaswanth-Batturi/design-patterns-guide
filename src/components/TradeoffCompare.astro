---
interface Props {
  withoutPains: [string, string, string];
  withWins: [string, string, string];
  codeBridge: string;
}

const { withoutPains, withWins, codeBridge } = Astro.props;
---

<section aria-labelledby="tradeoff-heading">
  <div class="mb-4">
    <h2 id="tradeoff-heading" class="text-lg font-semibold text-white">Same story in software</h2>
    <p class="mt-1 text-sm text-slate-400">{codeBridge}</p>
  </div>

  <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
    <div class="flex flex-col rounded-xl border border-rose-500/30 bg-rose-950/20 p-4 sm:p-5 min-h-[200px]">
      <h3 class="text-sm font-semibold text-rose-300">Without the pattern</h3>
      <ul class="mt-3 space-y-2.5 text-sm text-slate-300 flex-1">
        {withoutPains.map((item) => (
          <li class="flex gap-2.5 items-start">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-500/20 text-xs text-rose-400">×</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-col rounded-xl border border-emerald-500/30 bg-emerald-950/20 p-4 sm:p-5 min-h-[200px]">
      <h3 class="text-sm font-semibold text-emerald-300">With the pattern</h3>
      <ul class="mt-3 space-y-2.5 text-sm text-slate-300 flex-1">
        {withWins.map((item) => (
          <li class="flex gap-2.5 items-start">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs text-emerald-400">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
