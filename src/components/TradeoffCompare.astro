---
interface Props {
  example: string;
  withoutPains: [string, string, string];
  withWins: [string, string, string];
}

const { example, withoutPains, withWins } = Astro.props;
---

<section aria-labelledby="tradeoff-heading">
  <h2 id="tradeoff-heading" class="text-base font-semibold text-white">Without vs with the pattern</h2>
  <p class="mt-0.5 text-sm text-slate-500">
    Same example — <span class="text-slate-400">{example}</span> — applied to your code.
  </p>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-rose-500/25 bg-gradient-to-br from-rose-950/40 to-slate-950/40 p-4">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-rose-300">Without the pattern</h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-400">
        {withoutPains.map((item, i) => (
          <li class="flex gap-2">
            <span class="text-rose-400/70 shrink-0">{i + 1}.</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-xl border border-emerald-500/25 bg-gradient-to-br from-emerald-950/40 to-slate-950/40 p-4">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-emerald-300">With the pattern</h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-400">
        {withWins.map((item, i) => (
          <li class="flex gap-2">
            <span class="text-emerald-400/70 shrink-0">{i + 1}.</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
