---
interface Props {
  example: string;
  patternName: string;
  intro: string;
  withoutPains: [string, string, string];
  withWins: [string, string, string];
}

const { example, patternName, intro, withoutPains, withWins } = Astro.props;
---

<section aria-labelledby="tradeoff-heading">
  <h2 id="tradeoff-heading" class="text-lg font-semibold text-white">Without vs with the pattern</h2>
  <p class="mt-2 text-base leading-relaxed text-slate-400">{intro}</p>
  <p class="mt-2 text-sm text-slate-500">
    Still using <span class="text-slate-300">{example}</span> — here is the same story in code terms.
  </p>

  <div class="mt-5 grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl border border-rose-500/30 bg-gradient-to-br from-rose-950/45 to-slate-950/40 p-5">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-rose-300">Without {patternName}</h3>
      <p class="mt-2 text-sm text-rose-200/70">What breaks when you skip the pattern:</p>
      <ul class="mt-3 space-y-3 text-base leading-relaxed text-slate-300">
        {withoutPains.map((item, i) => (
          <li class="flex gap-3">
            <span class="text-rose-400/80 shrink-0 font-medium">{i + 1}.</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-xl border border-emerald-500/30 bg-gradient-to-br from-emerald-950/45 to-slate-950/40 p-5">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-300">With {patternName}</h3>
      <p class="mt-2 text-sm text-emerald-200/70">What improves when you apply it:</p>
      <ul class="mt-3 space-y-3 text-base leading-relaxed text-slate-300">
        {withWins.map((item, i) => (
          <li class="flex gap-3">
            <span class="text-emerald-400/80 shrink-0 font-medium">{i + 1}.</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
