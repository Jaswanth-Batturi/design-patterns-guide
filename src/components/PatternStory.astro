---
import { getIllustration } from '../data/patterns/pattern-illustrations';

interface Props {
  slug: string;
  icon: string;
  example: string;
  steps: [string, string, string];
}

const { slug, icon, example, steps } = Astro.props;
const illo = getIllustration(slug, icon);
const labels: [string, string, string] = ['Situation', 'Problem', 'Fix'];
---

<section class="rounded-xl border border-violet-500/20 bg-slate-900/40 overflow-hidden shadow-lg shadow-indigo-950/40" aria-label="Real-life analogy">
  <div class="border-b border-slate-800 bg-gradient-to-r from-indigo-950/80 via-violet-950/50 to-cyan-950/40 px-4 py-3 sm:px-5">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="text-base font-semibold text-white">Real-life analogy</h2>
      <span class="rounded-full bg-indigo-500/20 px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-indigo-200 border border-indigo-500/30">
        {example}
      </span>
    </div>
    <p class="mt-1 text-sm text-slate-400">{illo.label}</p>
  </div>

  <div class="grid sm:grid-cols-[minmax(0,220px)_1fr] gap-0">
    <div class="flex items-center justify-center border-b sm:border-b-0 sm:border-r border-slate-800 bg-gradient-to-br from-indigo-600/15 via-violet-600/10 to-cyan-500/10 p-5 sm:p-6">
      <div class="w-full max-w-[200px] drop-shadow-lg" set:html={illo.svg} />
    </div>

    <ol class="grid sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-slate-800 list-none">
      {steps.map((step, i) => (
        <li class="flex flex-col p-4 sm:p-5 min-h-[108px]">
          <span class="text-[10px] font-semibold uppercase tracking-wide text-violet-300/80">{labels[i]}</span>
          <span class="mt-2 text-sm leading-snug text-slate-300">{step}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
